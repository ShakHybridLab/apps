{
  "schema": 1,
  "apps": [
    {
      "path": "bimmer/apps/*",
      "manifest": "app.json",
      "icon": "icon.png",
      "mguHmi": [
        "ID7"
      ],
      "build": {
        "python": "bimmer/kit/tools/build.py",
        "args": [
          "{id}"
        ],
        "sdk": "bimmer/oap-sdk",
        "output": "bimmer/dist/{id}@{version}.tgz",
        "shared": [
          "bimmer/kit",
          "bimmer/shared"
        ]
      }
    }
  ],
  "components": [
    {
      "id": "jap_ridetube",
      "kind": "app",
      "path": "ridetube/apps/jap_ridetube",
      "build": {
        "python": "ridetube/kit/tools/build.py",
        "args": [
          "{id}"
        ],
        "sdk": "ridetube/oap-sdk",
        "output": "ridetube/dist/{id}@{version}.tgz"
      },
      "requires": {
        "jap-ridetube-d": "0.3.9",
        "mgu-render": "0.6.11",
        "mgu-inputgate": "1.0.0"
      },
      "uninstallable": true,
      "mguHmi": [
        "ID7"
      ]
    },
    {
      "id": "jap-ridetube-d",
      "kind": "tool",
      "path": "ridetube/service",
      "uninstallable": true,
      "mguHmi": [
        "ID7"
      ]
    }
  ]
}
