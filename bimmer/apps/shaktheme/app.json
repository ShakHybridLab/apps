  "signals": {
    "de.bmw.body.Light": {
      "IndicatorSteeringColumn": "s",
      "_optional": "le commodo des clignotants : la touche BC au bout fait passer à la vue suivante (operationColumnStalks vaut 64 pendant l'appui, vu sur la voiture du propriétaire avec ShakManette, photo du 19 nov. 2026)"
    },
    "de.bmw.infotainment.GPSData": {
      "GPSPositionCAN": "s",
      "_optional": "la position GPS de la voiture, pour l'alerte zone de danger (vue acceptée et disponible sur la voiture du propriétaire avec ShakGPS, photo du 19 nov. 2026)"
    },
    "de.bmw.infotainment.displaydataserver.DisplayDataServer": {
      "functionalLibraryData": "rs",
      "_optional": "ce que dessine le cluster BMW (functionalLibraryData) : sa vitesse (speed.kmH, la source des chiffres de vitesse depuis le 22 nov. 2026) et le régime moteur sous son autre nom (rpm), relus toutes les 50 ms"
    },
    "de.bmw.infotainment.vehicle.CDS": {
      "statusEngineSpeed2": "rs",
      "statusEngineTemperature": "rs"
    },
    "de.bmw.infotainment.vehicle.CDS2": {
      "statusLongitudinalAccelerationMassCenter": "rs",
      "statusLateralAccelerationMassCenter": "rs"
    },
    "de.bmw.infotainment.vehicle.Vehicle2": {
      "statusCarSpeed2": "rs"
    },
    "de.bmw.infotainment.drivingexcitement.FES": {
      "statusSwitchDriveDynamicSport2": "rs",
      "statusFESVehicleDynamicSwitchHMI": "rs"
    },
    "de.bmw.infrastructure.VehicleInformation": {
      "statusGearboxDrive": "s",
      "DataPowerTrain2": "s"
    },
    "com.harman.infotainment.systemfunctions.tasu.tasu.InternalTasu": {
      "_instances": "SystemFunctionsInternalTasuInst1",
      "_methods": [
        "sendTasuRequest"
      ],
      "_broadcasts": [
        "sendTasuResponse"
      ]
    },
    "de.bmw.infotainment.KombiIF": {
      "statusRangeTankStatus": "rs",
      "displayRangeElectricVehicle": "rs",
      "statusActiveCCMessage": "rs",
      "_optional": "statusActiveCCMessage: the check control message showing (the warning triangle beside the speed limit); the fuel and electric ranges. statusDisplayElectricalPowerDistribution (only shown on the Signals tab) was taken off on 23 Nov 2026: nothing drew from it"
    },
    "de.bmw.infotainment.vehicle.Vehicle": {
      "statusNewCurrentUnitsStatusExt": "rs",
      "_optional": "the car's pressure and temperature units, for the tyre block"
    },
    "de.bmw.infotainment.misc.MDrive": {
      "dataDisplayGearbox": "s",
      "_optional": "S or M next to the gear"
    },
    "de.bmw.infotainment.vehicle.TPMS": {
      "statusTyrePressure": "rs",
      "statusTyreTemperature": "rs",
      "_optional": "tyre pressures and temperatures in the M theme"
    },
    "de.bmw.infrastructure.EnvironmentalInformation": {
      "ExteriorTemperature": "s"
    },
    "de.bmw.infotainment.drivingexcitement.Efficiencytainment2": {
      "statusPowerRelativHybrid": "rs",
      "_optional": "the cluster's own relative power meter (statusPowerRelativHybrid: drive and recuperation in %, a name the Cluster apps installed on the car declare too) draws the hybrid rev bar; the two displayPowerDrive notifiers only read, shown on the Signals tab (quotaImmediateElectricEngineDriveRecuperation): notifiers without getter, only read, shown on the Signals tab"
    }
  },
