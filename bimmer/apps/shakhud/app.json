{
  "id": "shakhud",
  "title": "ShakHUD",
  "description": "ShakHUD: a HUD of its own for the windshield, the M Style rev counter (a bent bar, red in the red zone, light blue while electric, green while charging), with the battery, the ranges and the temperatures at the bottom right; hides itself while Waze's HUD map shows",
  "version": "0.2.0",
  "vendor": "custom",
  "loggingId": "OAS1",
  "iconGlyph": "SH",
  "shared": [
    "hud.js",
    "hud_text.js",
    "hud_data.js",
    "hud_themes.js",
    "layouts.js",
    "shaders.js",
    "icons.js",
    "emblems.js",
    "shift_score.js",
    "sun.js",
    "cluster_render_client.js",
    "calibration.js",
    "visible.js",
    "page.js",
    "previews.js",
    "sensors.js",
    "waze.js",
    "badges.js",
    "screen.js",
    "cluster_info.js",
    "danger.js",
    "free_rect.js",
    "map_window.js",
    "hybrid_tach.js",
    "runs.js",
    "tz.js",
    "shift_light.js"
  ],
  "signals": {
    "de.bmw.infotainment.vehicle.CDS": {
      "statusEngineSpeed2": "rs",
      "statusEngineTemperature": "rs"
    },
    "de.bmw.infotainment.vehicle.CDS2": {
      "statusLongitudinalAccelerationMassCenter": "rs",
      "statusLateralAccelerationMassCenter": "rs"
    },
    "de.bmw.infotainment.vehicle.Vehicle2": {
      "statusCarSpeed2": "rs"
    },
    "de.bmw.infotainment.drivingexcitement.FES": {
      "statusSwitchDriveDynamicSport2": "rs",
      "statusActualValueTorque2": "rs",
      "statusFESVehicleDynamicSwitchHMI": "rs"
    },
    "de.bmw.infrastructure.VehicleInformation": {
      "statusGearboxDrive": "s",
      "DataPowerTrain2": "s"
    },
    "com.harman.infotainment.systemfunctions.tasu.tasu.InternalTasu": {
      "_instances": "SystemFunctionsInternalTasuInst1",
      "_methods": [
        "sendTasuRequest"
      ],
      "_broadcasts": [
        "sendTasuResponse"
      ]
    },
    "de.bmw.infotainment.KombiIF": {
      "statusRangeTankStatus": "rs",
      "displayRangeElectricVehicle": "rs"
    },
    "de.bmw.infrastructure.EnvironmentalInformation": {
      "ExteriorTemperature": "s"
    }
  },
