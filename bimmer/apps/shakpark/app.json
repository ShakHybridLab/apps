{
  "id": "shakpark",
  "title": "ShakPark",
  "description": "Caméra avant (en D, sous 15 km/h) et caméra arrière (en marche arrière) dans la fenêtre centrale du thème du cluster",
  "version": "0.2.2",
  "vendor": "custom",
  "loggingId": "OAV2",
  "iconGlyph": "SP",
  "shared": [
    "park.js",
    "park_app.js",
    "park_demo.js",
    "park_frame.js",
    "video_bridge.js",
    "waze_yield.js",
    "cluster_render_client.js", "survive.js"
  ],
  "signals": {
    "de.bmw.infotainment.vehicle.Vehicle2": {
      "statusCarSpeed2": "rs"
    },
    "de.bmw.infrastructure.VehicleInformation": {
      "statusGearboxDrive": "s",
      "DataPowerTrain2": "s"
    }
  },
  "screens": [
    {
      "name": "MAIN",
      "kind": "menu",
      "title": "ShakPark",
      "settings": true
    }
  ],
  "settings": [
    {
      "key": "frontCam",
      "label": "Caméra avant en avançant sous 15 km/h",
      "type": "bool",
      "default": true
    },
    {
      "key": "wazeYield",
      "label": "La caméra prend la place de la carte Waze du cluster",
      "type": "bool",
      "default": true
    },
    {
      "key": "fillWindow",
      "label": "Remplir la fenêtre (les bords de l'image sont coupés, sans bandes noires)",
      "type": "bool",
      "default": false
    },
    {
      "key": "demo",
      "label": "Mode essai : une image de test à la place de la caméra (mêmes règles)",
      "type": "bool",
      "default": false
    },
    {
      "key": "rearCam",
      "label": "Caméra arrière en marche arrière",
      "type": "bool",
      "default": true
    }
  ],
  "config": {
    "socketPath": "/dev/shm/cluster-render/render.sock",
    "frontPath": "/dev/shm/shakpark-front",
    "rearPath": "/dev/shm/shakpark-rear",
    "wazeStatus": "/run/waze-on-cluster/status.json",
    "wazeCtl": "/dev/shm/waze-on-cluster/ctl.sock",
    "_comment": "Les images viennent de deux fichiers MGVF (shared/video_bridge.js) que l'outil de capture écrit ; sans eux, aucune image. Règles de vitesse et de rapport : shared/park.js, sans réglage pour les changer.",
    "lang": "fr"
  }
}
