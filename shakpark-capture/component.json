{
  "id": "jap-shakpark-capture",
  "kind": "tool",
  "version": "0.0.1",
  "license": "GPL-3.0-or-later",
  "title": "ShakPark camera capture (skeleton)",
  "requires": {
    "mgu-deploy": "0.7.0"
  },
  "uninstallable": true,
  "mguHmi": [
    "ID7"
  ],
  "files": [
    "capture.js",
    "mgvf_writer.js",
    "fake_decoder.js"
  ],
  "units": [
    {
      "name": "jap-shakpark-capture.service",
      "from": "jap-shakpark-capture.service"
    }
  ],
  "enable": [
    {
      "unit": "jap-shakpark-capture.service",
      "target": "multi-user.target"
    }
  ],
  "restart": [
    "jap-shakpark-capture.service"
  ]
}
