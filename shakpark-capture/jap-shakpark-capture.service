[Unit]
Description=jap-shakpark-capture: ShakPark camera capture (decodes the front or rear camera only while ShakPark asks)
RequiresMountsFor=/var/opt
After=local-fs.target

[Service]
# root: the camera ECU (SOME/IP) and the AVB stream.
User=root
ExecStart=/usr/bin/node /var/opt/jap-shakpark-capture/current/capture.js
# Idle when nothing is asked: it starts, waits, and stays active, so the deploy health check sees it active.
Restart=on-failure
RestartSec=3
TimeoutStopSec=5
LimitCORE=1

[Install]
WantedBy=multi-user.target
